//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define ADJUST   4
#define SCROLL   2

// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&trackball_listener {
    input-processors = <
                         &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                         &zip_temp_layer MOUSE 500
    >;

    scroller {
        layers = <SCROLL>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_xy_scaler 1 20
                            &zip_xy_to_scroll_mapper
        >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <3 4>;
            then-layer = <4>;
        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo 4>, <&mo 1>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo 4>, <&mo 1>;
        };

        // Customed Hold-Tap for SandS

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>;
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl 1>;

            label = "MKP_EXIT_AML";
        };

        detach: detach {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RC(B) &kp D>;
            label = "DETACH";
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        raycast {
            bindings = <&kp LC(SPACE)>;
            key-positions = <75 72>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp ESC     &kp N1      &kp N2  &kp N3    &kp N4           &kp N5                    &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                 &kp NUMBER_6  &kp N7  &kp N8     &kp N9   &kp N0    &kp DEL
&kp ESCAPE  &kp Q       &kp W   &kp E     &kp R            &kp T                     &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY               &kp Y         &kp U   &kp I      &kp O    &kp P     &kp BACKSPACE
&kp TAB     &kp A       &kp S   &kp D     &kp F            &kp G      &kp INS        &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp LBKT   &kp H         &kp J   &kp K      &kp L    &kp SEMI  &kp ENTER
&kp LSHIFT  &kp Z       &kp X   &kp C     &kp V            &kp B      &kp GRAVE      &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp RBKT   &kp N         &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RCTRL
&td0        &kp C_MUTE          &kp LWIN  &lt 4 BACKSPACE  &kp LANG2  &lt 2 SPACE                                                            &lt 3 RET  &kp LANG1                                           &td1
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&to_layer_0 ESC     &to_layer_0 N1  &to_layer_0 N2  &to_layer_0 N3  &to_layer_0 N4  &to_layer_0 N5               &trans  &trans  &trans  &trans                     &to_layer_0 N6  &to_layer_0 N7  &to_layer_0 N8     &to_layer_0 N9      &to_layer_0 N0         &to_layer_0 DELETE
&to_layer_0 TAB     &to_layer_0 Q   &to_layer_0 W   &to_layer_0 E   &to_layer_0 R   &to_layer_0 T                &trans  &trans  &trans  &trans                     &to_layer_0 Y   &to_layer_0 U   &to_layer_0 I      &to_layer_0 O       &to_layer_0 P          &to_layer_0 BACKSPACE
&to_layer_0 CAPS    &to_layer_0 A   &to_layer_0 S   &to_layer_0 D   &to_layer_0 F   &to_layer_0 G   &mkp MB4     &trans  &trans  &trans  &trans    &msc SCRL_LEFT   &to_layer_0 H   &to_layer_0 J   &to_layer_0 K      &to_layer_0 L       &to_layer_0 SEMICOLON  &to_layer_0 ENTER
&to_layer_0 LSHIFT  &to_layer_0 Z   &to_layer_0 X   &to_layer_0 C   &to_layer_0 V   &to_layer_0 B   &mkp MB5     &trans  &trans  &trans  &trans    &msc SCRL_RIGHT  &to_layer_0 N   &to_layer_0 M   &to_layer_0 COMMA  &to_layer_0 PERIOD  &to_layer_0 SLASH      &to_layer_0 RCTRL
&trans              &trans                          &trans          &mkp LCLK       &mkp MCLK       &mkp RCLK                                      &trans           &trans                                                                                        &trans
            >;
        };

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans      &kp F1     &kp F2       &kp F3     &kp F4         &kp F5                  &trans  &trans  &trans  &trans              &kp LA(F2)            &kp KP_N7          &kp KP_N8         &kp KP_N9              &kp KP_SLASH     &kp KP_NUMLOCK
&kp ESCAPE  &kp F6     &kp F7       &kp CARET  &kp AMPERSAND  &kp PIPE                &trans  &trans  &trans  &trans              &kp LA(SINGLE_QUOTE)  &kp DOUBLE_QUOTES  &kp LPAR          &kp RIGHT_PARENTHESIS  &kp LEFT_BRACE   &kp BACKSLASH
&kp TAB     &kp F11    &kp PERCENT  &kp HASH   &kp DOLLAR     &kp GRAVE  &kp PG_UP    &trans  &trans  &trans  &trans    &kp LPAR  &kp EXCL              &kp ASTRK          &kp LEFT_BRACKET  &kp RIGHT_BRACKET      &kp RIGHT_BRACE  &kp MINUS
&kp LSHFT   &none      &kp LEFT     &kp DOWN   &kp RIGHT      &kp END    &kp PG_DN    &trans  &trans  &trans  &trans    &kp RPAR  &kp QUESTION          &kp AT             &kp TILDE         &kp PERIOD             &kp KP_PLUS      &kp UNDERSCORE
&kp LCTRL   &kp RSHFT               &trans     &trans         &trans     &trans                                         &trans    &kp DEL                                                                                            &studio_unlock
            >;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
            bindings = <
&trans            &none        &none         &none         &none         &none                         &trans  &trans  &trans  &trans               &none           &none           &none     &none      &none  &none
&kp ESCAPE        &none        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ASTRK                     &trans  &trans  &trans  &trans               &none           &none           &none     &none      &none  &kp BACKSPACE
&kp LEFT_SHIFT    &kp PERCENT  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS  &msc SCRL_LEFT     &trans  &trans  &trans  &trans    &kp PG_UP  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP    &kp RIGHT  &none  &kp ENTER
&kp LEFT_CONTROL  &kp SLASH    &kp N7        &kp NUMBER_8  &kp NUMBER_9  &kp PLUS   &msc SCRL_RIGHT    &trans  &trans  &trans  &trans    &kp PG_DN  &kp END         &kp LEFT        &kp DOWN  &kp RIGHT  &none  &kp RCTRL
&kp LEFT_GUI      &none                      &trans        &trans        &kp EQUAL  &kp NUMBER_0                                         &trans     &kp DEL                                                     &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4             &trans  &trans  &trans  &trans              &bt BT_CLR_ALL    &bt BT_CLR        &none             &none             &none             &none
&trans  &none         &kp LS(LC(TAB))  &kp LC(TAB)   &kp LG(LEFT)  &kp LG(RIGHT)            &trans  &trans  &trans  &trans              &kp LC(DOWN)      &kp LC(UP)        &kp LC(LEFT)      &kp LC(RIGHT)     &none             &kp BACKSPACE
&trans  &kp LS(A)     &none            &detach       &kp LA(F)     &none          &none     &trans  &trans  &trans  &trans    &ind_bat  &out OUT_TOG      &none             &none             &none             &kp LA(U)         &kp LA(I)
&trans  &none         &none            &none         &none         &none          &none     &trans  &trans  &trans  &trans    &ind_con  &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LG(NUMBER_4)  &kp LG(NUMBER_5)  &kp LG(T)
&trans  &kp C_MUTE                     &trans        &trans        &trans         &trans                                      &trans    &kp DEL                                                                                   &trans
            >;
        };

        // Extra layer can be added in ZMK STUDIO

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
